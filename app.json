{
  "expo": {
    "name": "HitsterPersonalApp",
    "slug": "HitsterPersonalApp",
    "scheme": "hitsterpersonal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "La app usa la camara para escanear los codigos QR de las cartas."
      }
    },
    "android": {
      "package": "com.hitsterpersonal.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la camara para escanear los codigos QR de las cartas."
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "07f61ecc-007e-4ff9-bc3e-883c6e05e9d8"
      }
    },
    "owner": "andyurqui"
  }
}
